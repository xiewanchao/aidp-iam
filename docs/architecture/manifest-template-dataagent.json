{
  "_comment": "DataAgent 应用 Manifest。namespace/path_pattern 一旦上线不可更改。",
  "namespace": "DataAgent",
  "display_name": "智能问数",
  "base_url": "XXX",

  "resources": [
    {
      "_comment": "顶级资源：数据库（Databases）。含元数据、结构、知识等子资源。",
      "type": "Databases",
      "display_name": "数据库",
      "path_pattern": "/DataAgent/Tenants/{tenantId}/Databases/{db_id}",
      "methods": ["GET", "PUT", "DELETE"],
      "actions": [
        {
          "_comment": "测试数据库连通性（类型级 Action，无 db_id）",
          "name": "Test",
          "path_suffix": "/Test",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Viewer"
        },
        {
          "_comment": "检查链接状态（类型级 Action，无 db_id）",
          "name": "Check",
          "path_suffix": "/Check",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Viewer"
        },
        {
          "_comment": "格式化 SQL（实例级 Action）",
          "name": "PrettifySql",
          "path_suffix": "/PrettifySql",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Viewer"
        },
        {
          "_comment": "执行 SQL（实例级 Action）",
          "name": "ExecuteSql",
          "path_suffix": "/ExecuteSql",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Viewer"
        },
        {
          "_comment": "同步构建（实例级 Action）",
          "name": "Build",
          "path_suffix": "/Build",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Owner"
        },
        {
          "_comment": "流式构建（实例级 Action）",
          "name": "StreamBuild",
          "path_suffix": "/StreamBuild",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Owner"
        },
        {
          "_comment": "取消构建（实例级 Action）",
          "name": "Cancel",
          "path_suffix": "/Cancel",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Owner"
        },
        {
          "_comment": "检查是否存在需要刷新的枚举列【是否透出】（实例级 Action）",
          "name": "CheckRefresh",
          "path_suffix": "/CheckRefresh",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Owner"
        },
        {
          "_comment": "流式刷新枚举列【是否透出】（实例级 Action）",
          "name": "StreamRefresh",
          "path_suffix": "/StreamRefresh",
          "http_method": "POST",
          "required_role": "AccessManager/Tenants/System/Roles/Owner"
        }
      ],
      "default_acl": [],
      "children": [
        {
          "_comment": "单例子资源：元数据。Init/Process 为分析文档对齐后的 Action。",
          "type": "Metadata",
          "display_name": "元数据",
          "list_filter_mode": "gateway_inject",
          "path_pattern": "/DataAgent/Tenants/{tenantId}/Databases/{db_id}/Metadata",
          "methods": ["GET"],
          "actions": [
            {
              "_comment": "初始化元数据（暂不做，保留占位）",
              "name": "Init",
              "path_suffix": "/Init",
              "http_method": "POST",
              "required_role": "AccessManager/Tenants/System/Roles/Owner"
            },
            {
              "_comment": "合并更新数据库对象描述 + 字段枚举索引模式",
              "name": "Process",
              "path_suffix": "/Process",
              "http_method": "POST",
              "required_role": "AccessManager/Tenants/System/Roles/Owner"
            }
          ],
          "default_acl": [],
          "children": []
        },
        {
