FROM python:3.11-slim

WORKDIR /app
COPY cas-client-demo.py /app/cas-client-demo.py

ENV CAS_CLIENT_HOST=0.0.0.0 \
    CAS_CLIENT_PORT=18080 \
    KEYCLOAK_BASE_URL=https://localhost:30080 \
    REALM=aidp \
    SERVICE_URL=http://localhost:18080/cas/callback

EXPOSE 18080
CMD ["python", "/app/cas-client-demo.py"]
