# aidp-iam-app slim: code-only over a pre-built base.
# Used for fast iteration / air-gapped rebuilds 鈥?skips apt and pip.
# Layout matches Dockerfile (keycloak-proxy 鈫?/app/app to keep `app.*` imports).
ARG BASE_IMAGE=base-aidp-iam-app:v1
FROM ${BASE_IMAGE}

COPY apps/iam-api /app/app
COPY apps/pep-proxy/app /app/pep_proxy
COPY apps/pep-proxy/proto /app/proto
COPY apps/bundle-server/app /app/bundle_server
COPY apps/resource-sync/app /app/resource_sync
COPY apps/resource-sync/proto /app/rs_proto

RUN touch /app/app/__init__.py \
          /app/pep_proxy/__init__.py \
          /app/bundle_server/__init__.py \
          /app/resource_sync/__init__.py

RUN python -m grpc_tools.protoc \
        -I/app/proto \
        --python_out=/app \
        --grpc_python_out=/app \
        /app/proto/ext_authz.proto \
 && python -m grpc_tools.protoc \
        -I/app/rs_proto \
        --python_out=/app \
        --grpc_python_out=/app \
        /app/rs_proto/ext_proc.proto

COPY build/docker/aidp-iam-app/supervisord.conf /etc/supervisord.conf

EXPOSE 8000 8001 8080 8082 8090 9000

CMD ["/usr/local/bin/supervisord", "-c", "/etc/supervisord.conf"]
