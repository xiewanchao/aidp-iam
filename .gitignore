# Docker
*.tar

# Packaged Helm charts for release distribution (upload to GitHub Releases).
# NOTE: the vendored gateway-helm subchart .tgz under charts/*/charts/ is a
# real dependency and must be tracked; only exclude top-level packaged charts.
deploy/helm/aidp-gateway-*.tgz
deploy/helm/aidp-iam-*.tgz
deploy/helm/mocks/package-mock-*/aidp-mock-*-*.tgz

# Temporary contexts/artifacts generated by the openEuler Gateway image build.
build/openeuler/gateway/.build/

# helm dependency update artifact, recomputed locally and not part of source.
**/Chart.lock

# Temp
*.tmp
*.log
*.tar.gz
helm-*.tar.gz
*.litcoffee

